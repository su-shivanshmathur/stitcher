// DSL expression grammar (v1) — pure, total (PLAN §Schema-driven processors).
// Compiled into processors by `stitcher_macro::schema!`.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

expr    = { term ~ (bin_op ~ term)* }
term    = { literal | call | path | unary | "(" ~ expr ~ ")" }
unary   = { "!" ~ term }
call    = { ident ~ "(" ~ (expr ~ ("," ~ expr)*)? ~ ")" }
path    = { "log" ~ ("." ~ ident)* }
literal = { string | number | bool | null }
string  = @{ ("'" ~ (!"'" ~ ANY)* ~ "'") | ("\"" ~ (!"\"" ~ ANY)* ~ "\"") }
number  = @{ "-"? ~ ("0" | '1'..'9' ~ '0'..'9'*) ~ ("." ~ '0'..'9'*)? }
bool    = @{ "true" | "false" }
null    = @{ "null" }
ident   = @{ ('a'..'z' | 'A'..'Z' | "_") ~ ('a'..'z' | 'A'..'Z' | '0'..'9' | "_")* }
bin_op  = { "==" | "!=" | "<=" | ">=" | "<" | ">" | "&&" | "||" }
