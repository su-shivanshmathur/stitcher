// DSL expression grammar (v1) — pure, total. Interpreted by `stitcher::eval`.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

// Entry rule: the expression must consume the whole input — without the EOI anchor,
// pest returns a prefix match (a path like `log_type` would truncate at `log`).
file    = { SOI ~ or ~ EOI }

// Precedence, loosest to tightest: `||` < `&&` < comparison. `||`/`&&` are
// left-associative folds; comparison is NON-associative (at most one `cmp_op`
// per level, so `a == b == c` is a parse error). Only `cmp_op` is a named rule.
or      = { and ~ ("||" ~ and)* }
and     = { cmp ~ ("&&" ~ cmp)* }
cmp     = { term ~ (cmp_op ~ term)? }
term    = { literal | call | path | root | unary | "(" ~ or ~ ")" }
unary   = { "!" ~ term }
call    = { ident ~ "(" ~ (or ~ ("," ~ or)*)? ~ ")" }
// Identifier-rooted path (envelope fields sit next to `log`, so paths are not
// `log`-prefixed only). Atomic so no whitespace sneaks into the matched span.
path    = @{ ident ~ ("." ~ ident)* }
// `$` = the whole record (the event as sent), for flat schemas with no envelope.
root    = @{ "$" }
literal = { string | number | bool | null }
string  = @{ ("'" ~ (!"'" ~ ANY)* ~ "'") | ("\"" ~ (!"\"" ~ ANY)* ~ "\"") }
number  = @{ "-"? ~ ("0" | '1'..'9' ~ '0'..'9'*) ~ ("." ~ '0'..'9'*)? }
// Keyword literals carry a negative lookahead: `literal` is tried before `path` in
// `term` and PEG commits on the first match — without it, a field like `nullable`
// would match the `null` prefix and strand the rest of the input at EOI.
bool    = @{ ("true" | "false") ~ !ident_char }
null    = @{ "null" ~ !ident_char }
// One character that can continue an identifier.
ident_char = { 'a'..'z' | 'A'..'Z' | '0'..'9' | "_" }
ident   = @{ ('a'..'z' | 'A'..'Z' | "_") ~ ident_char* }
cmp_op  = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
