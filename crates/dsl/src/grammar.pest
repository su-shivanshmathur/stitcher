// DSL expression grammar (v1) — pure, total. Interpreted by `stitcher::eval`.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

// Without the EOI anchor pest returns a prefix match (`log_type` would truncate at `log`).
file    = { SOI ~ or ~ EOI }

// Precedence: `||` < `&&` < comparison. `||`/`&&` are left-associative folds; comparison
// is NON-associative (≤ 1 `cmp_op`, so `a == b == c` is a parse error).
or      = { and ~ ("||" ~ and)* }
and     = { cmp ~ ("&&" ~ cmp)* }
cmp     = { term ~ (cmp_op ~ term)? }
term    = { literal | call | path | root | unary | "(" ~ or ~ ")" }
unary   = { "!" ~ term }
call    = { ident ~ "(" ~ (or ~ ("," ~ or)*)? ~ ")" }
// Identifier-rooted path; atomic so no whitespace sneaks into the matched span.
path    = @{ ident ~ ("." ~ ident)* }
// `$` = the whole record (the event as sent).
root    = @{ "$" }
literal = { string | number | bool | null }
string  = @{ ("'" ~ (!"'" ~ ANY)* ~ "'") | ("\"" ~ (!"\"" ~ ANY)* ~ "\"") }
number  = @{ "-"? ~ ("0" | '1'..'9' ~ '0'..'9'*) ~ ("." ~ '0'..'9'*)? }
// Keyword literals carry a negative lookahead: without it PEG commits on the `null`
// prefix of a field like `nullable` and strands the rest of the input at EOI.
bool    = @{ ("true" | "false") ~ !ident_char }
null    = @{ "null" ~ !ident_char }
// One character that can continue an identifier.
ident_char = { 'a'..'z' | 'A'..'Z' | '0'..'9' | "_" }
ident   = @{ ('a'..'z' | 'A'..'Z' | "_") ~ ident_char* }
cmp_op  = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
